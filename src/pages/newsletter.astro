---
import BaseLayout from '../layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout
  title="Newsletter — OTD Vault"
  description="Sign up for the Old Texas Dude monthly newsletter. One dispatch per month on money, power, and accountability. No spam. Unsubscribe any time."
  hideNewsletterStrip={true}
>
  <!-- Hero -->
  <section class="nl-hero">
    <div class="nl-hero-inner">
      <p class="nl-eyebrow">Monthly Newsletter</p>
      <h1 class="nl-title">Stay in the ledger.</h1>
      <p class="nl-sub">One dispatch per month. No noise. Unsubscribe any time.</p>
    </div>
  </section>

  <!-- Signup card -->
  <section class="nl-body">
    <div class="nl-card">
      <p class="nl-what-label">WHAT YOU GET</p>
      <ul class="nl-what-list">
        <li>One curated dispatch — money, power, and accountability</li>
        <li>Picks worth your time — gear, food, and books</li>
        <li>No ads. No sponsored content. No fluff.</li>
      </ul>

      <form id="nl-form" class="nl-form">
        <input
          type="email"
          name="email"
          placeholder="your@email.com"
          required
          class="nl-input"
          autocomplete="email"
        />
        <button type="submit" class="nl-btn">Subscribe</button>
      </form>
      <p id="nl-note" class="nl-note">Monthly. No spam. Unsubscribe any time.</p>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var form = document.getElementById('nl-form');
    var note = document.getElementById('nl-note');
    if (!form) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      var email = form.querySelector('input[name="email"]').value;
      try {
        var res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });
        if (res.ok) {
          note.textContent = "You're on the list. Watch for the first dispatch.";
          note.style.color = 'var(--cedar)';
          form.style.display = 'none';
        } else {
          note.textContent = 'Something went wrong. Try again.';
          note.style.color = 'var(--clay)';
        }
      } catch {
        note.textContent = 'Network error. Try again.';
        note.style.color = 'var(--clay)';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    });
  })();
</script>

<style>
  .nl-hero {
    background: var(--ink);
    color: var(--bg-limestone);
    padding: 5rem 1.5rem 4.5rem;
    text-align: center;
  }
  .nl-hero-inner {
    max-width: 600px;
    margin: 0 auto;
  }
  .nl-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ochre);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .nl-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(2rem, 6vw, 3.2rem);
    font-weight: 700;
    color: var(--bg-limestone);
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }
  .nl-sub {
    font-family: 'Inter', sans-serif;
    font-size: 1rem;
    color: rgba(239, 233, 220, 0.7);
    margin: 0;
  }

  .nl-body {
    max-width: 560px;
    margin: 0 auto;
    padding: 4rem 1.5rem 6rem;
  }
  .nl-card {
    background: var(--card-bg);
    border: 1px solid rgba(43, 37, 32, 0.1);
    border-radius: 3px;
    padding: 2.5rem 2rem;
  }
  .nl-what-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    margin: 0 0 1rem;
  }
  .nl-what-list {
    list-style: none;
    padding: 0;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .nl-what-list li {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--ink);
    line-height: 1.5;
    padding-left: 1.25rem;
    position: relative;
  }
  .nl-what-list li::before {
    content: '›';
    color: var(--clay);
    position: absolute;
    left: 0;
    font-size: 1rem;
    line-height: 1.4;
  }
  .nl-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .nl-input {
    flex: 1;
    min-width: 200px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    padding: 0.65rem 1rem;
    border: 1.5px solid rgba(43, 37, 32, 0.18);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
  }
  .nl-input:focus {
    outline: none;
    border-color: var(--clay);
  }
  .nl-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    background: var(--clay);
    color: #fff;
    border: none;
    padding: 0.65rem 1.25rem;
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.15s;
  }
  .nl-btn:hover { opacity: 0.88; }
  .nl-btn:disabled { opacity: 0.55; cursor: not-allowed; }
  .nl-note {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    color: var(--ink-soft);
    margin: 0;
  }

  @media (max-width: 480px) {
    .nl-form { flex-direction: column; }
    .nl-btn { width: 100%; }
  }
</style>
