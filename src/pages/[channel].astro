---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
export const prerender = true;
type Channel = 'dispatch' | 'gear' | 'table' | 'chow' | 'transit' | 'coord' | 'lifestyle';
export async function getStaticPaths() {
  const channels = ['dispatch', 'gear', 'table', 'chow', 'transit', 'coord', 'lifestyle'];
  return channels.map(channel => ({ params: { channel } }));
}
const { channel } = Astro.params as { channel: Channel };
const channelMeta: Record<Channel, { title: string; description: string; eyebrow: string }> = {
  dispatch: {
    title: 'Dispatch Archives — OTD Vault',
    description: 'Every dispatch. Plain-spoken coverage of money, power, and accountability.',
    eyebrow: 'INDEPENDENT DISPATCH',
  },
  gear: {
    title: 'Gear Reviews — OTD Vault',
    description: 'Field-tested gear reviews. Tools, tech, and outdoor kit.',
    eyebrow: 'GEAR REVIEWS',
  },
  table: {
    title: 'The Table — OTD Vault',
    description: 'Restaurant reviews from Texas and beyond.',
    eyebrow: 'RESTAURANT REVIEWS',
  },
  chow: {
    title: 'The Kitchen — OTD Vault',
    description: 'Recipes, techniques, and kitchen picks.',
    eyebrow: 'KITCHEN & RECIPES',
  },
  transit: {
    title: 'Travel — OTD Vault',
    description: 'Road dispatches and local color, Texas first.',
    eyebrow: 'TRAVEL WRITING',
  },
  coord: {
    title: 'Getaways — OTD Vault',
    description: 'Weekend getaways and lodging reviews.',
    eyebrow: 'GETAWAYS & LODGING',
  },
  lifestyle: {
    title: 'Lifestyle — OTD Vault',
    description: 'Life off the clock. Health, travel, pets, and everything that isn’t politics or a product review.',
    eyebrow: 'LIFESTYLE',
  },
};
const meta = channelMeta[channel];
const posts = (await getCollection(channel as any))
  .sort((a: any, b: any) => new Date(b.data.date).valueOf() - new Date(a.data.date).valueOf());
const isDispatch = channel === 'dispatch';
const channelHeroImages: Partial<Record<Channel, string>> = {
  dispatch: '/images/archives-hero.jpg',
  gear: '/images/gear-hero.jpg',
  table: '/images/table-hero.jpg',
  chow: '/images/chow-hero.jpg',
  transit: '/images/transit-hero.jpg',
  coord: '/images/coord-hero.jpg',
  lifestyle: '/images/lifestyle-hero.jpg',
};
const heroImage = channelHeroImages[channel];

// Dispatch archive — split recent (card grid) from older (year list)
const RECENT_COUNT = 12;
const recentPosts = isDispatch ? posts.slice(0, RECENT_COUNT) : [];
const olderPosts  = isDispatch ? posts.slice(RECENT_COUNT) : [];

type PostEntry = (typeof posts)[number];
const olderByYear: { year: number; posts: PostEntry[] }[] = [];
if (olderPosts.length > 0) {
  const yearMap: Record<number, PostEntry[]> = {};
  (olderPosts as PostEntry[]).forEach((post) => {
    const year = new Date(post.data.date).getFullYear();
    if (!yearMap[year]) yearMap[year] = [];
    yearMap[year].push(post);
  });
  Object.entries(yearMap)
    .sort(([a], [b]) => Number(b) - Number(a))
    .forEach(([year, yPosts]) => olderByYear.push({ year: Number(year), posts: yPosts }));
}
---
<BaseLayout title={meta.title} description={meta.description}>
  <!-- Channel Header -->
  <section class={'channel-hero' + (heroImage ? ' has-photo' : '')} style={heroImage ? `--hero-img: url('${heroImage}')` : undefined}>
    <div class="hero-inner">
      <p class="hero-eyebrow">{meta.eyebrow}</p>
      <h1 class="hero-title">
        {channel === 'dispatch' ? 'Dispatch Archives' :
         channel === 'gear' ? 'Gear' :
         channel === 'table' ? 'The Table' :
         channel === 'chow' ? 'The Kitchen' :
         channel === 'transit' ? 'Travel' :
         channel === 'lifestyle' ? 'Lifestyle' :
         'Getaways'}
      </h1>
      {isDispatch && (
        <p class="hero-sub">Every dispatch. The file gets closed. The damage doesn't.</p>
      )}
    </div>
  </section>

  <!-- Posts -->
  <section class="posts-section">

    {/* Dispatch: recent grid cards + older year list */}
    {isDispatch && (
      <div class="dispatch-grid">
        {recentPosts.map((post: any) => (
          <PostCard
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            href={`/${channel}/${post.id.replace(/\.mdoc$/, '')}`}
            channel={channel}
            layout="grid"
            gallery={post.data.gallery}
          />
        ))}
      </div>
    )}

    {isDispatch && olderByYear.length > 0 && (
      <div class="archive-older">
        <p class="archive-heading">OLDER DISPATCHES</p>
        <input
          type="search"
          id="dispatch-search"
          class="archive-search-input"
          placeholder="Search all dispatches…"
          autocomplete="off"
        />
        <div id="search-results" class="search-results" hidden></div>
        <div id="year-groups">
          {olderByYear.map(({ year, posts: yPosts }) => (
            <details class="archive-year-group">
              <summary class="archive-year"><span>{year}</span></summary>
              <ul class="archive-list">
                {yPosts.map((post: any) => (
                  <li class="archive-item">
                    <a href={`/dispatch/${post.id.replace(/\.mdoc$/, '')}`} class="archive-title">
                      {post.data.title}
                    </a>
                    <time class="archive-date" datetime={post.data.date}>
                      {new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
                    </time>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </div>
    )}

    {/* All other channels: grid cards with images */}
    {!isDispatch && (
      <div class="card-grid">
        {posts.map((post: any) => (
          <PostCard
            title={post.data.title}
            date={post.data.date}
            description={post.data.description}
            href={`/${channel}/${post.id.replace(/\.mdoc$/, '')}`}
            channel={channel}
            layout="grid"
            gallery={post.data.gallery}
          />
        ))}
      </div>
    )}

    {posts.length === 0 && (
      <p class="empty-state">Nothing filed yet. Check back soon.</p>
    )}

  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var input = document.getElementById('dispatch-search');
    var resultsEl = document.getElementById('search-results');
    var yearGroups = document.getElementById('year-groups');
    if (!input) return;

    var pf = null;
    var timer = null;

    function loadPagefind() {
      if (pf) return Promise.resolve(pf);
      return import('/pagefind/pagefind.js')
        .then(function (lib) {
          return lib.init().then(function () { pf = lib; return pf; });
        })
        .catch(function () { return null; });
    }

    function clearSearch() {
      if (resultsEl) { resultsEl.hidden = true; resultsEl.innerHTML = ''; }
      if (yearGroups) yearGroups.style.display = '';
    }

    input.addEventListener('input', function () {
      clearTimeout(timer);
      var q = this.value.trim();
      if (!q) { clearSearch(); return; }

      timer = setTimeout(function () {
        loadPagefind().then(function (lib) {
          if (!lib) {
            resultsEl.innerHTML = '<p class="search-empty">Search index not ready — run a production build first.</p>';
            resultsEl.hidden = false;
            return;
          }
          return lib.search(q).then(function (search) {
            if (yearGroups) yearGroups.style.display = 'none';

            var hits = (search.results || []).filter(function (r) {
              return r.url && r.url.indexOf('/dispatch/') !== -1;
            }).slice(0, 20);

            if (hits.length === 0) {
              resultsEl.innerHTML = '<p class="search-empty">No dispatches matched “' + q + '”.</p>';
              resultsEl.hidden = false;
              return;
            }

            Promise.all(hits.map(function (r) { return r.data(); })).then(function (items) {
              resultsEl.innerHTML = items.map(function (r) {
                var title = (r.meta && r.meta.title) ? r.meta.title : 'Dispatch';
                return '<a href="' + r.url + '" class="search-result-item">'
                  + '<span class="search-result-title">' + title + '</span>'
                  + '<span class="search-result-excerpt">' + r.excerpt + '</span>'
                  + '</a>';
              }).join('');
              resultsEl.hidden = false;
            });
          });
        });
      }, 300);
    });

    input.addEventListener('search', function () {
      if (!this.value) clearSearch();
    });
  })();
</script>

<style>
  /* Hero */
  .channel-hero {
    position: relative;
    background: var(--ink);
    color: var(--bg-limestone);
    padding: 3rem 1.5rem 2.75rem;
    text-align: center;
  }
  .channel-hero.has-photo {
    background-image: var(--hero-img);
    background-size: cover;
    background-position: center 50%;
    padding: 5rem 1.5rem 4.5rem;
  }
  .channel-hero.has-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(20,16,12,0.70) 0%,
      rgba(20,16,12,0.55) 55%,
      rgba(20,16,12,0.75) 100%
    );
  }
  .channel-hero.has-photo .hero-inner {
    position: relative;
    z-index: 1;
  }
  .hero-inner { max-width: 640px; margin: 0 auto; }
  .hero-eyebrow {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    color: var(--ochre);
    margin: 0 0 0.75rem;
    text-transform: uppercase;
  }
  .hero-title {
    font-family: 'Fraunces', serif;
    font-size: clamp(1.9rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--bg-limestone);
    margin: 0 0 0.75rem;
    line-height: 1.1;
  }
  .hero-sub {
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    color: rgba(239,233,220,0.7);
    margin: 0;
  }

  /* Section container */
  .posts-section {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem 4rem;
  }
  .posts-section:has(.card-grid),
  .posts-section:has(.dispatch-grid) {
    max-width: 960px;
  }

  /* Dispatch recent grid */
  .dispatch-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.1rem;
    margin-bottom: 3rem;
  }

  /* Dispatch search */
  .archive-search-input {
    width: 100%;
    box-sizing: border-box;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    padding: 0.55rem 0.85rem;
    border: 1.5px solid rgba(43,37,32,0.18);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    margin-bottom: 1.25rem;
    display: block;
  }
  .archive-search-input:focus {
    outline: none;
    border-color: var(--clay);
  }
  .search-results {
    display: flex;
    flex-direction: column;
    margin-bottom: 0.5rem;
  }
  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(43,37,32,0.08);
    text-decoration: none;
    color: var(--ink);
  }
  .search-result-item:last-child { border-bottom: none; }
  .search-result-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink);
    transition: color 0.15s;
  }
  .search-result-item:hover .search-result-title { color: var(--clay); }
  .search-result-excerpt {
    font-family: 'Inter', sans-serif;
    font-size: 0.8rem;
    color: var(--ink-soft);
    line-height: 1.5;
  }
  .search-result-excerpt mark {
    background: rgba(181,72,46,0.12);
    color: inherit;
    border-radius: 2px;
    padding: 0 2px;
  }
  .search-empty {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    color: var(--ink-soft);
    padding: 0.5rem 0;
  }

  /* Older dispatches year list */
  .archive-older {
    border-top: 1px solid rgba(43,37,32,0.12);
    padding-top: 2rem;
  }
  .archive-heading {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }
  .archive-year-group {
    margin-bottom: 2rem;
  }
  .archive-year {
    list-style: none;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--ink);
    margin: 0 0 0.6rem;
    user-select: none;
  }
  .archive-year::-webkit-details-marker { display: none; }
  .archive-year::after {
    content: '›';
    font-size: 1rem;
    font-weight: 400;
    color: var(--clay);
    display: inline-block;
    transform: rotate(0deg);
    transition: transform 0.2s ease;
    line-height: 1;
  }
  .archive-year-group[open] > .archive-year::after {
    transform: rotate(90deg);
  }
  .archive-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .archive-item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(43,37,32,0.08);
  }
  .archive-item:last-child { border-bottom: none; }
  .archive-title {
    font-family: 'Inter', sans-serif;
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    line-height: 1.4;
    flex: 1;
  }
  .archive-title:hover { color: var(--clay); }
  .archive-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    color: var(--ink-soft);
    white-space: nowrap;
    letter-spacing: 0.04em;
  }

  /* Feed layout (kept for reference, no longer used for dispatch) */
  .feed-list {
    display: flex;
    flex-direction: column;
  }

  /* Card grid layout (non-dispatch channels) */
  .card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .empty-state {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.85rem;
    color: rgba(43,37,32,0.45);
    text-align: center;
    padding: 3rem 0;
  }

  @media (max-width: 640px) {
    .dispatch-grid { grid-template-columns: 1fr; }
  }
</style>
