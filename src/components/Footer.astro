---
interface Props { hideNewsletterStrip?: boolean; }
const { hideNewsletterStrip = false } = Astro.props;
---
<footer>
  <div class="footer-inner">
    {!hideNewsletterStrip && (
      <div class="nl-strip">
        <span class="nl-label">Sign up for Old Texas Dude's monthly newsletter</span>
        <div>
          <form id="footer-signup-form" class="nl-form">
            <input type="email" name="email" placeholder="your@email.com" required class="nl-input" />
            <button type="submit" class="nl-btn">Subscribe</button>
          </form>
          <p id="footer-signup-note" class="nl-note">Monthly. No spam. Unsubscribe any time.</p>
        </div>
      </div>
    )}

    <div class="footer-main">
      <div>
        <a href="/" class="footer-logo">OTD <span>VAULT</span></a>
        <p class="footer-tagline">Unfiltered dispatches on power, money, and who's actually pulling the strings.</p>
      </div>
      <div class="social-row">
        <a href="https://www.facebook.com/profile.php?id=61587629078907" target="_blank" rel="noopener" aria-label="Facebook">
          <img src="https://img.icons8.com/color/48/facebook-new.png" alt="Facebook" />
        </a>
        <a href="https://www.instagram.com/old_texas_dude/" target="_blank" rel="noopener" aria-label="Instagram">
          <img src="https://img.icons8.com/color/48/instagram-new.png" alt="Instagram" />
        </a>
        <a href="https://www.pinterest.com/V64OTD/" target="_blank" rel="noopener" aria-label="Pinterest">
          <img src="https://img.icons8.com/color/48/pinterest--v1.png" alt="Pinterest" />
        </a>
        <a href="https://mastodon.social/@v64otd.com" target="_blank" rel="noopener" aria-label="Mastodon">
          <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 216.4 232" fill="currentColor">
            <path d="M211.8 139.3c-2.9 15-26.1 31.4-52.7 34.6-13.9 1.7-27.5 3.2-42.1 2.5-23.8-1.1-42.6-5.7-42.6-5.7 0 2.3.1 4.5.4 6.7 2.9 21.9 21.5 23.2 39.1 23.8 17.8.6 33.7-4.4 33.7-4.4l.7 15.6s-12.5 6.7-34.7 7.9c-12.3.7-27.5-.3-45.2-4.7C28 206.1 2.4 175.6.3 138.9c-.6-10.5-.2-20.4-.2-28.7 0-36.1 23.7-46.7 23.7-46.7C35.4 57.7 56 55.2 77.4 55h.6c21.4.2 42 2.7 53.4 8.5 0 0 23.7 10.6 23.7 46.7 0 0 .3 26.6-43.3 27.3"/>
            <path d="M177.2 80.1v59.5h-23.6V81.7c0-12.2-5.1-18.3-15.4-18.3-11.3 0-17 7.3-17 21.8v31.6H97.7V85.2c0-14.5-5.7-21.8-17-21.8-10.3 0-15.4 6.1-15.4 18.3v57.9H41.7V80.1c0-12.2 3.1-21.8 9.3-28.9 6.4-7.1 14.8-10.8 25.2-10.8 12.1 0 21.2 4.6 27.2 13.9l5.9 9.8 5.9-9.8c6-9.3 15.1-13.9 27.2-13.9 10.4 0 18.8 3.7 25.2 10.8 6.1 7.1 9.2 16.7 9.2 28.9"/>
          </svg>
        </a>
        <a href="https://bsky.app/profile/v64otd.com.web.brid.gy" target="_blank" rel="noopener" aria-label="Bluesky">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 600 530" fill="currentColor">
            <path d="M135.72 44.03C202.216 93.951 273.74 195.17 300 249.46c26.262-54.29 97.782-155.508 164.28-205.43C512.06 8.566 590-19.354 590 68.844c0 17.625-10.198 148.21-16.186 169.379-20.93 74.046-91.59 92.954-159.05 81.526 114.448 20.31 143.628 87.354 80.728 154.382-119.477 126.94-171.572-31.873-184.85-72.575-2.452-7.405-3.612-10.875-3.642-7.94-.03-2.935-1.19.535-3.642 7.94-13.278 40.702-65.373 199.515-184.85 72.575-62.9-67.028-33.72-134.072 80.728-154.382-67.46 11.428-138.12-7.48-159.05-81.526C20.198 217.054 10 86.469 10 68.844 10-19.354 87.94 8.566 135.72 44.03z"/>
          </svg>
        </a>
        <a href="https://v64otd.com/rss.xml" target="_blank" rel="noopener" aria-label="RSS feed">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M3 3a18 18 0 0 1 18 18h-4a14 14 0 0 0-14-14V3z"/>
            <path d="M3 10a11 11 0 0 1 11 11H10a7 7 0 0 0-7-7v-4z"/>
            <circle cx="5.5" cy="18.5" r="2.5"/>
          </svg>
        </a>
      </div>
    </div>

    <div class="footer-affiliate">
      Shopping Amazon anyway?
      <a href="https://amzn.to/4vDY4A2" target="_blank" rel="noopener sponsored">Go through here</a>
      — costs you nothing, keeps the lights on.
      <span class="footer-dim">(affiliate link)</span>
    </div>

    <div class="footer-legal">
      <span>
        Looking for professional IT restoration?
        <a href="https://vintage64tx.com" target="_blank" rel="noopener" class="footer-highlight">VINTAGE64TX →</a>
      </span>
      <div class="footer-legal-links">
        <a href="/pages/privacy-policy">Privacy Policy</a>
        <a href="/pages/gear-policy">Affiliate Policy</a>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  (function () {
    var form = document.getElementById('footer-signup-form');
    var note = document.getElementById('footer-signup-note');
    if (!form) return;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button');
      btn.disabled = true;
      btn.textContent = 'Subscribing...';
      var email = form.querySelector('input[name="email"]').value;
      try {
        var res = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: email }),
        });
        if (res.ok) {
          note.textContent = "You're on the list.";
          note.style.color = '#6B7A5E';
          form.reset();
        } else {
          note.textContent = 'Something went wrong. Try again.';
          note.style.color = '#c9614d';
        }
      } catch {
        note.textContent = 'Network error. Try again.';
        note.style.color = '#c9614d';
      } finally {
        btn.disabled = false;
        btn.textContent = 'Subscribe';
      }
    });
  })();
</script>

<style>
  footer {
    background: #18110e;
    margin-top: 4rem;
    padding: 2.25rem 1.5rem 1.75rem;
  }

  .footer-inner {
    max-width: 1080px;
    margin: 0 auto;
  }

  /* Newsletter strip */
  .nl-strip {
    border-bottom: 1px solid rgba(240,236,227,0.08);
    padding-bottom: 20px;
    margin-bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px;
  }
  .nl-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 13px;
    font-weight: 700;
    color: rgba(216,210,200,0.5);
  }
  .nl-form {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .nl-input {
    font-family: 'Inter', sans-serif;
    font-size: 13px;
    padding: 7px 12px;
    border: 1.5px solid rgba(240,236,227,0.12);
    border-radius: 2px;
    background: rgba(255,255,255,0.04);
    color: #d8d2c8;
    min-width: 200px;
  }
  .nl-input::placeholder { color: rgba(216,210,200,0.35); }
  .nl-input:focus {
    outline: none;
    border-color: rgba(201,97,77,0.6);
  }
  .nl-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 1px;
    background: var(--clay);
    color: #fff;
    border: none;
    padding: 7px 16px;
    border-radius: 2px;
    cursor: pointer;
    white-space: nowrap;
  }
  .nl-btn:hover { background: #c9614d; }
  .nl-note {
    font-family: 'Inter', sans-serif;
    font-size: 11px;
    color: rgba(216,210,200,0.35);
    margin: 6px 0 0;
    text-align: right;
  }

  /* Main row */
  .footer-main {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 28px;
  }
  .footer-logo {
    font-family: 'Fraunces', serif;
    font-size: 18px;
    font-weight: 700;
    color: #d8d2c8;
    text-decoration: none;
    display: block;
    margin-bottom: 8px;
  }
  .footer-logo span { color: #c9614d; }
  .footer-tagline {
    font-size: 13px;
    color: rgba(216,210,200,0.45);
    max-width: 280px;
    line-height: 1.5;
  }

  /* Social icons — visible on dark background */
  .social-row {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }
  .social-row a {
    opacity: 0.75;
    display: inline-block;
    line-height: 0;
    color: #d8d2c8;
    transition: opacity 0.2s;
  }
  .social-row a:hover { opacity: 1; }
  .social-row img {
    height: 26px;
    display: block;
  }
  .social-row svg { display: block; }

  /* Affiliate row */
  .footer-affiliate {
    border-top: 1px solid rgba(240,236,227,0.08);
    padding-top: 18px;
    margin-bottom: 14px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: rgba(216,210,200,0.45);
    line-height: 1.6;
  }
  .footer-affiliate a { color: #c9614d; }
  .footer-dim { opacity: 0.45; }

  /* Legal row */
  .footer-legal {
    border-top: 1px solid rgba(240,236,227,0.08);
    padding-top: 20px;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: rgba(216,210,200,0.45);
  }
  .footer-highlight { color: #c9614d; margin-left: 4px; }
  .footer-legal-links {
    display: flex;
    gap: 16px;
  }
  .footer-legal a { color: rgba(216,210,200,0.45); }
  .footer-legal a:hover { color: #d8d2c8; }

  @media (max-width: 640px) {
    .footer-main { flex-direction: column; }
    .nl-strip { flex-direction: column; align-items: flex-start; }
    .social-row { gap: 14px; }
  }
</style>
