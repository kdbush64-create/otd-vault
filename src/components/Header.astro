---
const pathname = Astro.url.pathname;
const isDispatch = pathname === '/dispatch' || pathname.startsWith('/dispatch/');
const isReviews = ['/reviews','/gear','/table','/chow','/transit','/coord'].some(
  p => pathname === p || pathname.startsWith(p + '/')
);
const isLifestyle = pathname === '/ledger' || pathname.startsWith('/ledger/');
const isAbout = pathname === '/about' || pathname.startsWith('/about/');
const isPicks = pathname === '/picks' || pathname.startsWith('/picks/');
---
<header>
  <div class="nav-wrap">
    <a class="brand" href="/">OTD <span>VAULT</span></a>
    <nav>
      <a href="/dispatch" class={isDispatch ? 'active' : ''}>DISPATCHES</a>      
      <a href="/ledger" class={isLifestyle ? 'active' : ''}>MY LEDGER</a>      
      <a href="/reviews" class={isReviews ? 'active' : ''}>REVIEWS</a>
      <a href="/picks" class={isPicks ? 'active' : ''}>PICKS</a>
      <a href="/about" class={isAbout ? 'active' : ''}>ABOUT OTD</a>
    </nav>
  </div>
</header>
