---
interface Props {
  title: string;
  date?: string;
  description?: string;
  href: string;
  channel?: string;
  layout?: 'feed' | 'card' | 'grid';
  gallery?: { image: string; alt?: string }[];
}
const {
  title,
  date,
  description,
  href,
  channel = 'dispatch',
  layout = 'card',
  gallery,
} = Astro.props;
const formattedDate = date
  ? new Date(date).toLocaleDateString('en-US', {
      year: 'numeric', month: 'long', day: 'numeric',
    })
  : null;
const channelLabels: Record<string, string> = {
  dispatch: 'Dispatch',
  gear: 'Gear',
  table: 'The Table',
  chow: 'The Kitchen',
  transit: 'Travel',
  coord: 'Getaways',
};
const channelLabel = channelLabels[channel] ?? channel;
const accentClass = channel === 'gear'
  ? 'accent-cedar'
  : channel === 'transit'
  ? 'accent-bluebonnet'
  : channel === 'coord'
  ? 'accent-thistle'
  : channel === 'table'
  ? 'accent-clay'
  : channel === 'chow'
  ? 'accent-ochre'
  : 'accent-ink';
const thumbImage = gallery && gallery.length > 0 ? gallery[0] : null;
const readLabel = channel === 'dispatch' ? 'Read dispatch →' : 'Read the review →';
---
{layout === 'grid' ? (
  <a href={href} class={`post-grid-card h-entry ${accentClass}`}>
    <div class="grid-thumb">
      {thumbImage ? (
        <img src={thumbImage.image} alt={thumbImage.alt ?? ''} loading="lazy" decoding="async" />
      ) : (
        <div class="grid-thumb-fallback"></div>
      )}
      <span class="grid-badge">{channelLabel}</span>
    </div>
    <div class="grid-body">
      {formattedDate && (
        <time class="grid-date dt-published" datetime={date}>{formattedDate}</time>
      )}
      <h2 class="grid-title p-name">{title}</h2>
      {description && <p class="grid-desc p-summary">{description}</p>}
      <span class="grid-read">{readLabel}</span>
    </div>
    <data class="u-url" value={`https://v64otd.com${href}`} hidden></data>
  </a>
) : layout === 'feed' ? (
  <a href={href} class={`post-feed-item h-entry ${accentClass}`}>
    {formattedDate && (
      <time class="feed-date dt-published" datetime={date}>{formattedDate}</time>
    )}
    {thumbImage && (
      <div class="feed-thumb">
        <img src={thumbImage.image} alt={thumbImage.alt ?? ''} loading="lazy" decoding="async" />
      </div>
    )}
    <h2 class="feed-title p-name">{title}</h2>
    {description && <p class="feed-desc p-summary">{description}</p>}
    <data class="u-url" value={`https://v64otd.com${href}`} hidden></data>
  </a>
) : (
  <a href={href} class={`post-card ${accentClass}`}>
    <div class="card-meta">
      <span class="card-channel">{channelLabel}</span>
      {formattedDate && (
        <time class="card-date" datetime={date}>{formattedDate}</time>
      )}
    </div>
    <h2 class="card-title">{title}</h2>
    {description && <p class="card-desc">{description}</p>}
    <span class="card-read">Read →</span>
  </a>
)}
<style>
  /* ── Grid card (homepage) ── */
  .post-grid-card {
    display: flex;
    flex-direction: column;
    background: var(--card-bg);
    border: 1px solid #d9d0c2;
    border-radius: 3px;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .post-grid-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(43,37,32,.09);
  }
  .grid-thumb {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--ink);
  }
  .grid-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .grid-thumb-fallback {
    width: 100%;
    height: 100%;
    background: var(--ink);
  }
  .grid-badge {
    position: absolute;
    bottom: 10px;
    left: 12px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    background: var(--clay);
    color: #fff;
    padding: 3px 8px;
    border-radius: 2px;
  }
  .accent-cedar  .grid-badge { background: var(--cedar); }
  .accent-ochre  .grid-badge { background: var(--ochre); }
  .accent-clay   .grid-badge { background: var(--clay); }
  .grid-body {
    padding: 1rem 1.1rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 0.35rem;
  }
  .grid-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--ink-soft);
  }
  .grid-title {
    font-family: 'Fraunces', serif;
    font-size: 1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
    margin: 0;
  }
  .grid-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.82rem;
    color: var(--ink-soft);
    line-height: 1.55;
    flex: 1;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .grid-read {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    color: var(--clay);
    margin-top: 0.25rem;
  }

  /* ── Feed item (dispatch) ── */
  .post-feed-item {
    display: block;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border, rgba(43,37,32,0.12));
    text-decoration: none;
    color: inherit;
  }
  .post-feed-item:last-child {
    border-bottom: none;
  }
  .feed-thumb {
    margin: 0.5rem 0 0.75rem;
    width: 100%;
    max-width: 200px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 4px;
  }
  .feed-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* ── Card layout (review channels) ── */
  .post-card {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    border-radius: 4px;
    padding: 1.35rem 1.25rem 1.15rem;
    text-decoration: none;
    color: var(--ink);
    transition: transform 0.15s, box-shadow 0.15s;
  }
  .post-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(43,37,32,0.09);
  }
  .accent-cedar { border-top: 3px solid var(--cedar); }
  .accent-clay  { border-top: 3px solid var(--clay);  }
  .accent-ochre { border-top: 3px solid var(--ochre); }
  .accent-ink   { border-top: 3px solid var(--ink);   }
  .accent-bluebonnet { border-top: 3px solid var(--bluebonnet); }
  .accent-thistle    { border-top: 3px solid var(--thistle);    }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .card-channel {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cedar);
  }
  .accent-clay  .card-channel { color: var(--clay); }
  .accent-ochre .card-channel { color: var(--ochre); }
  .accent-ink   .card-channel { color: var(--ink); }
  .accent-bluebonnet .card-channel { color: var(--bluebonnet); }
  .accent-thistle    .card-channel { color: var(--thistle);    }
  .card-date {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: rgba(43,37,32,0.4);
  }
  .card-title {
    font-family: 'Fraunces', serif;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    margin: 0.15rem 0 0;
    line-height: 1.3;
  }
  .card-desc {
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    color: rgba(43,37,32,0.62);
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .card-read {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--clay);
    margin-top: 0.5rem;
  }
</style>
